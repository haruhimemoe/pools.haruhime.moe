# Copy to .env.local and fill in. Never commit real values: secrets stay empty here.

# MongoDB connection string, like mongodb+srv://user:password@cluster.example.net. The app uses the "pools"
# database and reads the haruhime.moe hub's "identity" database (users and sessions) on the same cluster. Its user
# must have readWrite on "pools" and only read on "identity": pools refuses to start when it can reach another
# database, or write to identity (see POOLS_ALLOW_SHARED_DB_USER below).
MONGODB_URI=

# The haruhime.moe hub's BETTER_AUTH_SECRET (the same value): pools checks the hub's session cookie with it.
# Sign-in itself runs only on the hub.
BETTER_AUTH_SECRET=

# osu! OAuth app (https://osu.ppy.sh/home/account/edit#oauth): its client ID (a number, 12345 is only an example)
# and secret. pools uses them for osu! API lookups (client credentials: /check, adding editors), not for sign-in.
OSU_CLIENT_ID=12345
OSU_CLIENT_SECRET=

# osu! user ids with admin rights, comma-separated, like 1234567,7654321. Empty means nobody has them.
ADMIN_OSU_IDS=

# Where packs lives. Empty means https://packs.haruhime.moe.
PACKS_URL=

# The token packs expects from pools (packs' POOLS_SERVICE_TOKEN), at least 32 characters. Empty means pools never
# updates packs: imports then need --no-sync, and admin saves can't update a pool's pack.
POOLS_SERVICE_TOKEN=

# Optional. "true" lets pools run on a database user that reaches other databases too, like a user it shares with
# packs. The user still needs readWrite on "pools", and pools logs a warning naming the other databases. Empty (or
# anything but "true") keeps the strict check. SECURITY.md explains the risk.
POOLS_ALLOW_SHARED_DB_USER=

# Optional. "true" shows a small "beta" tag beside the pools wordmark on every page. Next.js reads it when it builds
# the site, so a change needs a new build. Empty (or anything but "true") shows no tag.
NEXT_PUBLIC_POOLS_BETA=

# The haruhime.moe hub: sign-in, the account page and session refreshes. Empty means https://www.haruhime.moe.
HUB_URL=

# Optional. The hub's account export/delete fan-out (/api/internal/account/*) sends it as a Bearer token:
# the same value as the hub's ACCOUNT_SECRET_POOLS. At least 32 characters. Generate one with:
# openssl rand -base64 32. Empty means those routes refuse every call.
ACCOUNT_FANOUT_SECRET=

# Optional. harumin's bearer secret for GET /api/internal/similar/<id> (/practice). The same
# value as the bot's POOLS_SERVICE_SECRET. At least 32 characters (openssl rand -base64 32).
# Empty means that route refuses every call.
HARUMIN_SERVICE_SECRET=

# Optional. tourney.haruhime.moe reads pools by id from /api/internal/pools/[id] with it as a Bearer
# token: the same value as tourney's TOURNEY_SERVICE_SECRET. At least 32 characters. Generate one with:
# openssl rand -base64 32. Empty means that route refuses every call.
TOURNEY_SERVICE_SECRET=

# Optional, CI only. Builds without real secrets by using placeholders nothing connects with.
# SKIP_ENV_VALIDATION=true
