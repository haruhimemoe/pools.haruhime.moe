# Copy to .env.local and fill in. Never commit real values: secrets stay empty here.

# MongoDB connection string, like mongodb+srv://user:password@cluster.example.net. The app uses the "pools"
# database, and its user must have readWrite on "pools" only: pools refuses to start when it can reach another one
# (see POOLS_ALLOW_SHARED_DB_USER below).
MONGODB_URI=

# Optional. "true" lets pools run on a database user that reaches other databases too, like a user it shares with
# packs. The user still needs readWrite on "pools", and pools logs a warning naming the other databases. Empty (or
# anything but "true") keeps the strict check. SECURITY.md explains the risk.
POOLS_ALLOW_SHARED_DB_USER=

# better-auth session secret, at least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL better-auth builds its callback URLs from.
BETTER_AUTH_URL=http://localhost:3000

# osu! OAuth app (https://osu.ppy.sh/home/account/edit#oauth): its client ID (a number, 12345 is only an example)
# and secret. Admin sign-in and the /check lookups both use it. Set the app's callback URL to
# {BETTER_AUTH_URL}/api/auth/callback/osu.
OSU_CLIENT_ID=12345
OSU_CLIENT_SECRET=

# osu! user ids that may sign in (the admins), comma-separated, like 1234567,7654321. Empty means nobody can.
ADMIN_OSU_IDS=

# Where packs lives. Empty means https://packs.haruhime.moe.
PACKS_URL=

# The token packs expects from pools (packs' POOLS_SERVICE_TOKEN), at least 32 characters. Empty means pools never
# updates packs: imports then need --no-sync, and admin saves can't update a pool's pack.
POOLS_SERVICE_TOKEN=

# Optional, CI only. Builds without real secrets by using placeholders nothing connects with.
# SKIP_ENV_VALIDATION=true
